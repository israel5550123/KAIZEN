{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(bash publicacao/implantar.sh*)",
      "PowerShell(& \"C:\\Program Files\\Git\\bin\\bash.exe\" publicacao/implantar.sh*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(docker stack rm*)",
      "Bash(docker volume rm*)",
      "Bash(docker system prune*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(docker secret *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(docker stack rm*)",
      "PowerShell(docker volume rm*)",
      "PowerShell(docker system prune*)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
      "PowerShell(docker secret *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/sem-perguntas.js"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guarda-bash.js"
          }
        ]
      }
    ]
  }
}
